# Path to Quendaward's data directory (where ham_coordinator.db lives)
# This is mounted read-only so the media app can read award/callsign data
QUENDAWARD_DATA_DIR=../award_planner/data

# Admin password hash (SHA-256 hex digest)
# Generate with: python3 -c "import hashlib; print(hashlib.sha256(b'YOUR_PASSWORD').hexdigest())"
# Default is the hash of "admin"
ADMIN_PASSWORD_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Application title
APP_TITLE=Special Callsign Media Sharing

# Nginx server_name directive (e.g. "example.com" or "example.com www.example.com")
# Defaults to "_" (catch-all) if not set
NGINX_SERVER_NAME=_

# Port to expose on the host (default 8080 to avoid conflicts with Quendaward's nginx)
HTTP_PORT=8080
