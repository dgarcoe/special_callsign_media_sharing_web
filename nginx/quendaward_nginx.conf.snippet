# ──────────────────────────────────────────────────────────────
# Add these location blocks to Quendaward's nginx config
# (inside the server {} block that handles your domain).
#
# The media app container (quendaward-media) is reachable on
# the shared ea1rfi-network at port 8501.
# ──────────────────────────────────────────────────────────────

# Media sharing app
location /quendaward_media {
    proxy_pass http://quendaward-media:8501/quendaward_media;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 86400;
}

# Media sharing app - Streamlit WebSocket
location /quendaward_media/_stcore/stream {
    proxy_pass http://quendaward-media:8501/quendaward_media/_stcore/stream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
}
